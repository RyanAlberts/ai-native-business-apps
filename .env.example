# =============================================================================
# AI-Native Business Apps — environment variables
# =============================================================================
# Copy this file to .env and fill in the keys for the providers you want to use.
#
# CLAUDE (DEFAULT, RECOMMENDED): no key needed if you've run `claude` once.
#   The agents call the Claude Code CLI under the hood, which uses your
#   Claude Max / Pro subscription auth. DO NOT set ANTHROPIC_API_KEY unless
#   you specifically want to bill against an Anthropic API account.
# =============================================================================

# --- Anthropic (API mode only — leave UNSET for subscription mode) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ALLOW_API_KEY=1   # required if ANTHROPIC_API_KEY is set and you accept API billing

# --- OpenAI ---
# OPENAI_API_KEY=sk-...

# --- Google Gemini ---
# GOOGLE_API_KEY=...

# --- xAI ---
# XAI_API_KEY=xai-...

# --- Tool integrations (per-agent, only if you enable them) ---
# FIRECRAWL_API_KEY=fc-...
# TAVILY_API_KEY=tvly-...
# EXA_API_KEY=...
# SERP_API_KEY=...

# --- Defaults applied across all agents (override per-agent in config.yaml) ---
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
